package components

import (
	"encoding/json"
	"fmt"
	"log"
	"shikakaQuelor/bootleg/internals/systembolaget"
	"shikakaQuelor/bootleg/internals/taxes"
	"strconv"
)

templ Products(products []taxes.Product, metadata systembolaget.Metadata) {
	for _, product := range products {
		<div class="bg-white/85 backdrop-blur-sm border border-gray-200 rounded-xl p-4 mb-2 shadow-sm flex gap-4 items-start">
			<!-- Left column: image + donut -->
			<div class="flex flex-col items-center gap-2 shrink-0">
				if len(product.Images) > 0 {
					<img class="h-28 w-auto object-contain" src={ product.Images[0].ImageURL + "_200.png" } alt={ product.ProductNameBold }/>
				} else {
					<div class="h-28 w-16 bg-gray-100 rounded flex items-center justify-center text-gray-400 text-xs">Bild saknas</div>
				}
				<!-- Donut chart: % tax+fees of total price, pure SVG -->
				<svg viewBox="0 0 36 36" class="w-20 h-20" xmlns="http://www.w3.org/2000/svg">
					<!-- Background ring -->
					<circle
						cx="18" cy="18" r="15"
						fill="none"
						stroke="#d1d5db"
						stroke-width="3.5"
					></circle>
					<!-- Tax arc: starts at top (rotate -90deg around center) -->
					<circle
						cx="18" cy="18" r="15"
						fill="none"
						stroke="#f8d648"
						stroke-width="3.5"
						stroke-linecap="round"
						stroke-dasharray={ strconv.FormatFloat((1-float64(product.OriginalPrice/product.Price))*360, 'f', 1, 64) + " 360" }
						pathLength="360"
						transform="rotate(-90 18 18)"
					></circle>
					<!-- Percentage label centered -->
					<text
						x="18" y="18"
						text-anchor="middle"
						dominant-baseline="middle"
						font-size="5"
						font-family="sans-serif"
						font-weight="600"
						fill="#374151"
					>
						{ strconv.FormatFloat((1-float64(product.OriginalPrice/product.Price))*100, 'f', 1, 64) }%
					</text>
				</svg>
			</div>
			<!-- Right column: product info + price breakdown -->
			<div class="flex flex-col gap-2 flex-1 min-w-0">
				<div>
					<p class="font-semibold text-gray-900 leading-tight">{ product.ProductNameBold }</p>
					<p class="text-xs text-gray-500 mt-0.5">
						{ product.CategoryLevel1 } &middot; { product.VolumeText } &middot; { strconv.FormatFloat(product.AlcoholPercentage, 'f', -1, 64) }% &middot; Art.nr { product.ProductID }
					</p>
				</div>
				<!-- Price breakdown -->
				<div class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-0.5 text-sm">
					<span class="text-gray-600">Inköpspris</span>
					<span class="text-gray-600 text-right">{ strconv.FormatFloat(float64(product.OriginalPrice), 'f', 2, 64) } kr</span>
					<span class="text-gray-600">Alkoholskatt</span>
					<span class="text-gray-600 text-right">{ strconv.FormatFloat(product.AlcoholTax, 'f', 2, 64) } kr</span>
					<span class="text-gray-600">Systembolagets påslag</span>
					<span class="text-gray-600 text-right">{ strconv.FormatFloat(float64(product.SystembolagetPercentageCut+product.SystembolagetUnitCut), 'f', 2, 64) } kr</span>
					<span class="text-gray-600">Moms (25%)</span>
					<span class="text-gray-600 text-right">{ strconv.FormatFloat(float64(product.Vat), 'f', 2, 64) } kr</span>
					<span class="font-semibold text-gray-900 border-t border-gray-200 pt-1">Du betalar</span>
					<span class="font-semibold text-gray-900 text-right border-t border-gray-200 pt-1">{ strconv.FormatFloat(float64(product.Price), 'f', 2, 64) } kr</span>
				</div>
				<button
					hx-post="/details"
					hx-vals={ fmt.Sprintf("%s", encode(product)) }
					hx-target="body"
					hx-swap="beforeend"
					hx-trigger="click"
					class="self-start text-xs text-blue-600 hover:text-blue-800 hover:underline"
				>Mer info...</button>
			</div>
		</div>
	}
	if metadata.NextPage > 0 {
		<div
			hx-post="/search"
			hx-vals={ fmt.Sprintf(`{"nextPage": "%d", "search": "%s", "current": "%v"}`, metadata.NextPage, metadata.Query, metadata.Total) }
			hx-target="this"
			hx-trigger="revealed"
			hx-swap="outerHTML"
			class="text-center text-gray-400 py-4 text-sm"
		>
			{ fmt.Sprintf("Visar %v av %v möjliga produkter", metadata.Total, metadata.DocumentCount) }
		</div>
	} else if metadata.NextPage == -1 {
		<div class="text-center text-gray-400 py-4 text-sm">
			{ fmt.Sprintf("Visar %v av %v möjliga produkter", metadata.Total, metadata.DocumentCount) }
		</div>
	}
}

func encode(product taxes.Product) string {
	p, err := json.Marshal(product)
	if err != nil {
		log.Printf("failed to encode product %s: %v", product.ProductID, err)
		return ""
	}
	return string(p)
}
